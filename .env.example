# Copy to .env (git-ignored) and set your own values:
#   cp .env.example .env
#
# Used by compose.yaml (PostgreSQL container) and by the API in dev mode.

# Host port for the PostgreSQL container. Use another one (for example 5433)
# if a PostgreSQL installed on your machine already listens on 5432.
DB_PORT=5432
DB_NAME=bouleplan
DB_USERNAME=bouleplan
DB_PASSWORD=change-me

# Copy to .env (git-ignored) and set your own values:
#   cp .env.example .env
#
# Used by compose.yaml (PostgreSQL container) and by the API in dev mode.

# Host port for the PostgreSQL container. Use another one (for example 5433)
# if a PostgreSQL installed on your machine already listens on 5432.
DB_PORT=5432
DB_NAME=bouleplan
DB_USERNAME=bouleplan
# Required: Docker Compose refuses to start while it is empty.
DB_PASSWORD=

# Host ports of the API and the web app when they run in Docker
# (docker compose --profile dev up). Change them if 8080 or 3000 are taken.
API_PORT=8080
WEB_PORT=3000

# Production (compose.prod.yaml): DB_NAME, DB_USERNAME and DB_PASSWORD above are reused,
# and WEB_PORT is the only published port. Use a strong DB_PASSWORD, and remember that
# PostgreSQL applies it only when the db-data volume is first created.
# Images built locally by default; set these to pull published tags instead.
# API_IMAGE=bouleplan-api:local
# WEB_IMAGE=bouleplan-web:local

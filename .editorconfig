root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Google Java Style: 2-space indent, 100-column lines.
[*.java]
max_line_length = 100

[*.{kts,gradle}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[{gradlew,*.sh}]
end_of_line = lf

[*.bat]
end_of_line = crlf
